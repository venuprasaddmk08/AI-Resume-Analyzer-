# Copy this file to .env and fill in values as needed.
# The application must run without any of these being set (DEMO_MODE / local fallbacks).

# Key from https://openrouter.ai/keys — starts with "sk-or-"
OPENROUTER_API_KEY=
# Any model ID your OpenRouter key has access to that supports JSON mode.
# See https://openrouter.ai/models for the current list; a free-tier option is
# meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GITHUB_TOKEN=
YOUTUBE_API_KEY=

DATABASE_URL=sqlite:///./app.db

MAX_UPLOAD_SIZE_MB=10
MAX_PROVIDER_RESUMES=25

# Comma-separated list of allowed frontend origins for CORS
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# When true (or when OPENROUTER_API_KEY is missing), AI-dependent features fall
# back to deterministic, clearly-labeled behavior instead of calling a live model.
DEMO_MODE=true
