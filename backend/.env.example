# Copy this file to .env and fill in values as needed.
# The application must run without any of these being set (DEMO_MODE / local fallbacks).

# Key from https://console.groq.com/keys — free, starts with "gsk_"
GROQ_API_KEY=
# Any model ID your Groq key has access to that supports JSON mode.
# See https://console.groq.com/docs/models for the current list.
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GITHUB_TOKEN=
YOUTUBE_API_KEY=

DATABASE_URL=sqlite:///./app.db

MAX_UPLOAD_SIZE_MB=10
MAX_PROVIDER_RESUMES=25

# Comma-separated list of allowed frontend origins for CORS
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# When true (or when GROQ_API_KEY is missing), AI-dependent features fall
# back to deterministic, clearly-labeled behavior instead of calling a live model.
DEMO_MODE=true
